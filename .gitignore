# Local secrets and overrides
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local experiments, generated evaluations and user-supplied unseen tenders.
# Existing tracked gold/audit files remain tracked; add new reviewed audits explicitly.
/.audit_tmp/
/.pytest-*/
/eval/.tmp*/
/eval/audit/
/new_unseen/

# Corpus / uploads (large binaries live outside git; manifests are tracked)
backend/data/manufacturers/*/raw/
backend/data/uploads/
backend/data/tmp/
# The test corpus: real catalogue PDFs and GeM tenders, far too large for git.
# The manifest that describes them is tracked, so the corpus stays auditable.
backend/data/catalogue/*/
backend/data/tenders/

# Agent worktrees (git worktree directories live here, not in the repo)
.claude/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
