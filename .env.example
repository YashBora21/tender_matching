# Copy to .env and fill in. Never commit .env.
# Every value here is read by backend/app/core/config.py; nothing is hardcoded in code.

# --- Application ---
APP_NAME=tender-backend
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector) ---
# Host-side URL (local docker compose, port published to 5432)
DATABASE_URL=postgresql+psycopg://tender:change-me@localhost:5432/tender
# In-container URL used by docker-compose (overrides DATABASE_URL for the backend service)
DATABASE_URL_DOCKER=postgresql+psycopg://tender:change-me@db:5432/tender
# Credentials for the pgvector container (must match DATABASE_URL)
POSTGRES_USER=tender
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tender
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5

# --- Storage ---
# Where raw corpus files and uploaded tenders live. Originals stay on disk, hashed in Postgres.
DATA_DIR=backend/data

# --- Document ingestion ---
# A page with less text than this is read through OCR instead (FR-9).
INGEST_MIN_CHARS_FOR_TEXT=10
# The confidence carried by a chunk read through OCR. OCR can be wrong, so the
# evidence is flagged for review.
INGEST_OCR_CONFIDENCE=0.5
# The OCR language and resolution. A non-English tender needs its own language.
INGEST_OCR_LANGUAGE=eng
INGEST_OCR_DPI=200
# A line at least this long ends a chunk; shorter lines are joined with the
# ones around them.
INGEST_MIN_CHUNK_CHARS=80
# A header or footer sits in the top or bottom band of the page, this far
# from the edge.
INGEST_HEADER_BAND_FRACTION=0.12
# Where Tesseract keeps its language data. PyMuPDF's OCR cannot find it on
# Windows without this. Linux usually does not need it.
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# --- Aliases (FR-20) ---
# An alias below this confidence does not resolve a name: the requirement
# goes to review instead of being matched on a weak mapping.
ALIAS_CONFIDENCE_THRESHOLD=0.8

# --- Attribute vocabulary ---
# The canonical attribute catalogue is a data file, not code. Point this at your
# own copy to extend it without touching the app. Unset = the shipped default
# (backend/data/attribute_vocabulary.json).
# ATTRIBUTE_VOCABULARY_PATH=backend/data/attribute_vocabulary.json

# --- LLM / embeddings (keys stay in env, never in code) ---
# The provider is a base URL: Groq serves gpt-oss, a local Ollama serves the
# embedding model, the HuggingFace router serves either.
LLM_API_KEY=your-key-here
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
# gpt-oss is a reasoning model: the answer comes after the reasoning, and a
# small budget is spent entirely on reasoning and returns an empty answer.
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
# The dimension of the model's vectors. Changing the model means a migration.
EMBEDDING_DIMENSION=768

# --- fetching tender attachments ---
# A tender links to documents on other hosts, and the collector follows those
# links. It only follows them on the hosts it is allowed to, never to a
# private address, and never past a redirect to another host.
FETCH_ALLOWED_DOMAINS=gem.gov.in,bidplus.gem.gov.in,mkp.gem.gov.in,admin.gem.gov.in,fulfilment.gem.gov.in
FETCH_MAX_BYTES=52428800
FETCH_TIMEOUT_SECONDS=60
# A document already frozen, with the same hash, is not fetched again.
FETCH_CACHE_ENABLED=true
# Hosts allowed to be private. Empty in production: a fetch must not reach
# the machine's own network. A test needs it for its own local server.
FETCH_ALLOWED_PRIVATE_HOSTS=

# --- API ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Scoring policy (PRD 8) ---
# Per-requirement scores and the weights used to compute compatibility %.
SCORING_FULL_SCORE=1.0
SCORING_PARTIAL_DEFAULT=0.5
SCORING_MISSING_SCORE=0.0
# Family-level evidence is capped and flagged for review, never a confirmed match.
SCORING_FAMILY_LEVEL_CAP=0.5
# Mandatory requirements weigh twice an optional one.
SCORING_WEIGHT_MANDATORY=2
SCORING_WEIGHT_OPTIONAL=1

# --- Comparison policy (the rules the evaluators apply) ---
# Two values this far apart are treated as the same number.
COMPARISON_EQUALITY_TOLERANCE=0.05
# "Approximately" is accepted this far from the required value.
COMPARISON_APPROXIMATION_TOLERANCE=0.2
# How far short of a numeric requirement a capability may fall and still count
# as a partial match rather than a capability failure. PRD 4 names
# "1200 RPM max vs 1500 RPM required" as Missing capability (a 20% shortfall),
# so the default sits below that.
COMPARISON_NUMERIC_PARTIAL_TOLERANCE=0.1
# Score band for a partial match, and the score for family-level evidence.
COMPARISON_PARTIAL_SCORE_MIN=0.25
COMPARISON_PARTIAL_SCORE_MAX=0.75
COMPARISON_FAMILY_LEVEL_SCORE=0.5
# Document classes in descending authority. A conflict between two classes is
# resolved by the higher one; a conflict inside one class stays a conflict and
# goes to review (FR-25).
EVIDENCE_PRIORITY=compliance_schedule,technical_offer,datasheet

# --- Tests ---
# Set to a disposable database to run the migration integration test.
# TEST_DATABASE_URL=postgresql+psycopg://tender:change-me@localhost:5432/tender_test
