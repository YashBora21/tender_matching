# Copy to .env and fill in. Never commit .env.
# Everything the stack reads comes from here. The backend values are declared in
# backend/app/core/config.py; nothing is hardcoded in business logic.

# --- Application ---
APP_NAME=tender-backend
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# Which deployment the health endpoint says it is. It was a string inside the
# route, so a container reported "local".
APP_ENVIRONMENT=local

# --- Database (PostgreSQL + pgvector) ---
# Host-side URL (a local Postgres, or docker compose with port 5432 published)
DATABASE_URL=postgresql+psycopg://tender:change-me@localhost:5432/tender
# Credentials for the pgvector container. docker-compose derives the backend's
# in-container DATABASE_URL from these, so they are the single source of truth
# for the compose stack; they must match a host-side DATABASE_URL that points at
# that container.
POSTGRES_USER=tender
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tender
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5

# --- Storage ---
# Where raw corpus files and uploaded tenders live. Originals stay on disk, hashed in Postgres.
DATA_DIR=backend/data

# --- Document ingestion ---
# A page with less text than this is read through OCR instead (FR-9).
INGEST_MIN_CHARS_FOR_TEXT=10
# The confidence carried by a chunk read through OCR. OCR can be wrong, so the
# evidence is flagged for review.
INGEST_OCR_CONFIDENCE=0.5
# The OCR language and resolution. A non-English tender needs its own language.
INGEST_OCR_LANGUAGE=eng
INGEST_OCR_DPI=200
# A specification whose first page yields fewer characters than this has no
# text a reader could use: a scan the OCR could not read, which is not the
# same answer as a document that states nothing (D-156).
INGEST_OCR_MIN_CHARS=40
# A line at least this long ends a chunk; shorter lines are joined with the
# ones around them.
INGEST_MIN_CHUNK_CHARS=80
# A header or footer sits in the top or bottom band of the page, this far
# from the edge.
INGEST_HEADER_BAND_FRACTION=0.12
# Where Tesseract keeps its language data. PyMuPDF's OCR cannot find it on
# Windows without this. Linux usually does not need it.
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# --- Aliases (FR-20) ---
# An alias below this confidence does not resolve a name: the requirement
# goes to review instead of being matched on a weak mapping.
ALIAS_CONFIDENCE_THRESHOLD=0.8

# --- Attribute vocabulary ---
# The canonical attribute catalogue is a data file, not code. Point this at your
# own copy to extend it without touching the app. Unset = the shipped default
# (backend/data/attribute_vocabulary.json).
# ATTRIBUTE_VOCABULARY_PATH=backend/data/attribute_vocabulary.json
# The product categories and the words that name them (FR-16). A category is
# added by editing this file, never by editing code.
# CATEGORY_VOCABULARY_PATH=backend/data/categories.json
# The document types, filename markers and extensions the collector and the
# evidence layer both read.
# DOC_TYPES_PATH=backend/data/doc_types.json

# --- LLM / embeddings (keys stay in env, never in code) ---
# Set an OpenAI-compatible chat-completions endpoint, key and model privately.
# Switching providers changes runtime configuration only.
LLM_API_KEY=
# Optional independent text credential. Blank uses LLM_API_KEY.
LLM_TEXT_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Reasoning models may need sufficient output budget before producing an answer.
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
# A ceiling on what one process may spend, for a key that is rate-limited or
# metered. 0 = no ceiling. Past either one the run stops as `rate_limited`,
# keeps the results it found, and resumes from where it stopped without
# paying for an answer it already has.
LLM_CALL_BUDGET=200
LLM_TOKEN_BUDGET=400000
# Persistent caps. The two limits above bound one process; these bound a day and
# a month across restarts, because every billable call is written to the
# `llm_spend` table. Off by default. Enabling a cap without a price refuses the
# first call instead of treating it as free.
LLM_SPEND_CAPS_ENABLED=false
LLM_DAILY_CAP_INR=0
LLM_MONTHLY_CAP_INR=1000
# What the provider charges, in INR per million tokens. Fill these from your own
# tariff; the repository ships no price because the currency and the rate are
# deployment facts.
LLM_COST_INPUT_PER_MTOK_INR=
LLM_COST_OUTPUT_PER_MTOK_INR=
# How many times a rate-limited call is tried again, and how long the wait
# starts at. A provider's `Retry-After` overrides the wait when it sends one.
LLM_MAX_RETRIES=1
LLM_RETRY_SECONDS=5
# 0 because the same tender has to give the same requirements on a rerun: a
# temperature above it makes a re-run disagree with the report already filed.
LLM_TEMPERATURE=0
# Embeddings run locally: sentence-transformers loads public weights, with no
# account and no inference credits. Set EMBEDDING_BACKEND=http to call an
# OpenAI-compatible endpoint (EMBEDDING_BASE_URL) instead; a local Ollama is
# one such endpoint.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
# The dimension of the model's vectors. Changing the model means a migration
# and re-embedding: vectors from two models are not comparable.
EMBEDDING_DIMENSION=384
# How many texts one embedding call carries. The local model runs out of
# memory on a large batch; the corpus walk and the encoder both read this one
# value, so a batch is never split two ways.
EMBEDDING_BATCH_SIZE=32

# --- matching and retrieval ---
# How many retrieved passages one requirement may be read against. Every
# passage is a model call, so this is the cost ceiling of a match, and a
# smaller number trades recall for it (FR-22).
MATCH_MAX_CANDIDATES=20
# A hit on one page of a document this many pages long brings its sibling pages
# too, in page order: a datasheet's specification page rarely repeats the words
# on its cover (D-102).
RETRIEVAL_SIBLING_PAGE_LIMIT=3

# --- fetching tender attachments and the corpus ---
# A tender links to documents on other hosts, and the collector follows those
# links. It only follows them on the hosts it is allowed to, never to a
# private address, and never past a redirect to another host.
# This list is for addresses found inside a tender. `make corpus-restore` is
# not gated by it: a corpus manifest records the operator's own addresses and
# checks the answer against the hash written in it, so the corpus can be
# restored from any public host while a tender still reaches only these ones.
# A manufacturer joins this list when its own robots.txt allows its PDFs.
# KSB and Crane are absent - both disallow *.pdf, and compliance is the
# reason, not an oversight.
FETCH_ALLOWED_DOMAINS=gem.gov.in,bidplus.gem.gov.in,mkp.gem.gov.in,admin.gem.gov.in,fulfilment.gem.gov.in,flowserve.com,emerson.com,circor.com,xylem.com,pentair.com,apollovalves.com,abb.com,nidec.com
FETCH_MAX_BYTES=52428800
# A collected document is allowed to be bigger than a tender attachment: the
# corpus has a 95 MB catalogue in it.
CORPUS_MAX_BYTES=209715200
FETCH_TIMEOUT_SECONDS=60
# Who the site is asked to let in. A robots.txt rule can name an agent
# deliberately, and the collector and the fence both read this, so "did this
# host allow this" has one answer.
FETCH_USER_AGENT=tender-corpus-collector/1.0
# A document already frozen, with the same hash, is not fetched again.
FETCH_CACHE_ENABLED=true
# Hosts allowed to be private. Empty in production: a fetch must not reach
# the machine's own network. A test needs it for its own local server.
FETCH_ALLOWED_PRIVATE_HOSTS=

# --- API ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Seconds between retries of the startup repair while the database is down.
# A row left mid-read stays "processing" until the repair runs (D-163).
RECONCILE_RETRY_SECONDS=30

# --- Frontend (PRD 14) ---
# The address the *browser* uses to reach the backend. It is compiled into the
# bundle when the frontend image is built, so changing it needs a rebuild:
#   docker compose build frontend
VITE_API_URL=http://localhost:8000

# --- Scoring policy (PRD 8) ---
# Per-requirement scores and the weights used to compute compatibility %.
SCORING_FULL_SCORE=1.0
SCORING_MISSING_SCORE=0.0
# Family-level evidence is capped and flagged for review, never a confirmed match.
SCORING_FAMILY_LEVEL_CAP=0.5
# Mandatory requirements weigh twice an optional one.
SCORING_WEIGHT_MANDATORY=2
SCORING_WEIGHT_OPTIONAL=1

# --- Comparison policy (the rules the evaluators apply) ---
# Two values this far apart are treated as the same number.
COMPARISON_EQUALITY_TOLERANCE=0.05
# "Approximately" is accepted this far from the required value.
COMPARISON_APPROXIMATION_TOLERANCE=0.2
# How far short of a numeric requirement a capability may fall and still count
# as a partial match rather than a capability failure. PRD 4 names
# "1200 RPM max vs 1500 RPM required" as Missing capability (a 20% shortfall),
# so the default sits below that.
COMPARISON_NUMERIC_PARTIAL_TOLERANCE=0.1
# Score band for a partial match, and the score for family-level evidence.
COMPARISON_PARTIAL_SCORE_MIN=0.25
COMPARISON_PARTIAL_SCORE_MAX=0.75
COMPARISON_FAMILY_LEVEL_SCORE=0.5
# Whether a higher pressure class answers a lower requirement outright. Default
# false: a Class 300 valve against a Class 150 clause is a partial match that
# goes to review, because a higher rating is not automatically interchangeable
# (wall thickness, face-to-face, weight, cost). Set true only when the buyer
# has said a higher class is acceptable (D-99).
COMPARISON_PRESSURE_CLASS_HIGHER_COVERS_LOWER=false
# Document classes in descending authority. A conflict between two classes is
# resolved by the higher one; a conflict inside one class stays a conflict and
# goes to review (FR-25).
EVIDENCE_PRIORITY=compliance_schedule,technical_offer,datasheet

# --- pipeline ---
# The shape of a stored requirement. Cached results and stage keys are built
# from it, so changing it invalidates what was already written and re-extracts.
SCHEMA_VERSION=1
# How often a tender being read is written down and streamed to the UI (D-82).
# It bounds the extra database writes and how stale the live list may be.
STREAM_INTERVAL_SECONDS=1

# --- Tests ---
# Set to a disposable database to run the migration integration test.
# TEST_DATABASE_URL=postgresql+psycopg://tender:change-me@localhost:5432/tender_test
# Grouped fact extraction is opt-in until measured on reviewed gold labels.
MATCH_EXTRACTION_BATCH_SIZE=1
MATCH_EXTRACTION_BATCH_CHARS=12000

# Local OCR. Paddle runs in an isolated persistent interpreter with its own CUDA runtime.
OCR_BACKEND=tesseract
# OCR_WORKER_PYTHON=/absolute/path/to/ocr/python
# OCR_WORKER_EXTRA_SITES=/absolute/path/to/ocr/dependency/site-packages
# OCR_CUDA_DLL_DIR=/absolute/path/to/compatible/CUDA/libraries
# OCR_WEIGHTS_DIR=/absolute/path/to/public/ocr/weights
OCR_TIMEOUT_SECONDS=180
PADDLE_OCR_DEVICE=cpu
PADDLE_OCR_LANGUAGE=en
PADDLE_OCR_MAX_SIDE=1280
OCR_LINE_OVERLAP=0.3
OCR_TABLE_MIN_COLUMNS=3

# Opt-in clause classification before BOQ assignment; validate before enabling.
REQUIREMENT_CLASSIFICATION_ENABLED=false
REQUIREMENT_CLASSIFICATION_MAX_CHARS=4000

# Nominal designators are table lookups, not physical length conversions.
NOMINAL_SIZE_TOLERANCE=0.001
NORMALIZATION_POLICY_PATH=
