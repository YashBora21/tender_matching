{
  "version": "source-roles-2",
  "form_policy_version": "1",
  "form_source_role": "supporting",
  "form_default_type": "informational",
  "form_product_subject_pattern": "^\\s*(?:the\\s+)?(?:product|equipment|component|assembly)\\b",
  "form_actor_subject_pattern": "\\b(?:principal|employer|buyer|bidder|supplier|contractor|bank|signatory|parties|party|witness(?:es)?)\\b",
  "form_physical_action_pattern": "\\b(?:shall|must|should)\\s+(?:withstand|operate|resist|endure)\\b",
  "form_clause_prefix_pattern": "^\\s*\\d+(?:\\.\\d+)+\\s+",
  "form_clause_intro_words": ["in", "if", "the", "where", "whereas", "for", "unless", "when", "and", "or"],
  "form_page_types": {"commercial_legal": "commercial", "boilerplate": "informational", "wrapper_metadata": "informational", "catalogue_discovery": "informational"},
  "form_heading_patterns": [
    "^(?:pre[- ]contract\\s+)?integrity\\s+pact$",
    "\\(\\s*(?:format|form|proforma)\\s+(?:of|for)\\s+(?:integrity\\s+pact|bank\\s+guarantee|declaration|undertaking)\\s*\\)",
    "^(?:(?:format|form|proforma)\\s+(?:of|for)\\s+)?(?:bank\\s+guarantee|affidavit|undertaking|declaration)(?:\\s+(?:of|for|by)\\b.*)?$"
  ],
  "fragment_prose_roles": ["cover", "atc", "sla", "supporting"],
  "primary_roles": ["specification", "boq"],
  "requirement_source_roles": ["specification", "boq"],
  "restricted_roles": ["cover", "atc", "sla", "supporting", "unknown"],
  "nontechnical_types": ["commercial", "eligibility", "informational"],
  "template_min_distinct_tenders": 3,
  "restricted_filename_patterns": {
    "atc": ["(?:^|[^a-z])atc(?:[^a-z]|$)", "additional[ _-]+terms"],
    "sla": ["(?:^|[^a-z])sla(?:[^a-z]|$)", "service[ _-]+level[ _-]+agreement"]
  }
}
